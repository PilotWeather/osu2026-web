generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Team {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Personnel {
  id             String       @id @default(cuid())
  sourceKey      String       @unique
  sourceSequence Int?
  nationalId     String?      @unique
  firstName      String
  lastName       String
  phone          String?
  email          String?
  birthDate      DateTime?
  tshirtSize     String?
  licenseNo      String?
  notes          String?
  isActiveFlying Boolean      @default(false)
  companyId      String?
  teamId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company?     @relation(fields: [companyId], references: [id])
  team           Team?        @relation(fields: [teamId], references: [id])
  vehicles       Vehicle[]
  credentials    Credential[]

  @@index([companyId])
  @@index([teamId])
  @@index([licenseNo])
  @@index([isActiveFlying])
}

model Vehicle {
  id          String    @id @default(cuid())
  personnelId String
  plate       String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, plate])
  @@index([personnelId, active])
}

model Credential {
  id          String         @id @default(cuid())
  personnelId String
  type        CredentialType
  expiryDate  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  personnel   Personnel      @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, type])
  @@index([type, expiryDate])
}

enum CredentialType {
  SEP
  SEP_FI
  CLASS_1
}

model AuthorizedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([role])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  DATA_MANAGER
  VIEWER
}
