generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Team {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Personnel {
  id                String           @id @default(cuid())
  sourceKey         String           @unique
  sourceSequence    Int?
  nationalId        String?          @unique
  firstName         String
  lastName          String
  canonicalFullName String?
  phone             String?
  email             String?
  birthDate         DateTime?
  tshirtSize        String?
  licenseNo         String?
  notes             String?
  isActiveFlying    Boolean          @default(false)
  naeronEmployeeId  String?          @unique
  naeronVmId        String?
  companyId         String?
  teamId            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company?         @relation(fields: [companyId], references: [id])
  team              Team?            @relation(fields: [teamId], references: [id])
  vehicles          Vehicle[]
  credentials       Credential[]
  instructedFlights Flight[]         @relation("FlightInstructor")
  observedFlights   Flight[]         @relation("FlightObserver")
  importRows        ImportRow[]
  aliases           PersonnelAlias[]

  @@index([companyId])
  @@index([teamId])
  @@index([licenseNo])
  @@index([isActiveFlying])
  @@index([naeronVmId])
  @@index([canonicalFullName])
}

model PersonnelAlias {
  id              String    @id @default(cuid())
  personnelId     String
  alias           String
  normalizedAlias String
  createdAt       DateTime  @default(now())
  personnel       Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, normalizedAlias])
  @@index([normalizedAlias])
}

model Vehicle {
  id          String    @id @default(cuid())
  personnelId String
  plate       String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, plate])
  @@index([personnelId, active])
}

model Credential {
  id          String         @id @default(cuid())
  personnelId String
  type        CredentialType
  expiryDate  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  personnel   Personnel      @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, type])
  @@index([type, expiryDate])
}

enum CredentialType {
  SEP
  SEP_FI
  CLASS_1
}

model AuthorizedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([role])
}

model Aircraft {
  id                String    @id @default(cuid())
  registration      String    @unique
  aircraftType      String?
  naeronAircraftId  String?   @unique
  naeronVmId        String?
  currentTach       Decimal?  @db.Decimal(12, 2)
  lastFlightDate    DateTime?
  lastBase          String?
  underMaintenance  Boolean   @default(false)
  ueggs             DateTime?
  naeronPayload     Json?
  upstreamUpdatedAt DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  flights           Flight[]

  @@index([active])
  @@index([naeronVmId])
  @@index([underMaintenance])
}

model Student {
  id               String   @id @default(cuid())
  normalizedName   String   @unique
  displayName      String
  naeronPersonId   String?  @unique
  naeronVmId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  flights          Flight[] @relation("PrimaryStudent")
  secondaryFlights Flight[] @relation("SecondStudent")

  @@index([naeronVmId])
}

model ImportBatch {
  id                        String       @id @default(cuid())
  originalFilename          String
  fileHash                  String
  flightDate                DateTime?
  status                    ImportStatus @default(PENDING)
  totalRows                 Int          @default(0)
  validRows                 Int          @default(0)
  importedRows              Int          @default(0)
  warningRows               Int          @default(0)
  rejectedRows              Int          @default(0)
  sourceRows                Int          @default(0)
  completedRows             Int          @default(0)
  cancelledRows             Int          @default(0)
  validationDurationMinutes Int?
  validationPassed          Boolean      @default(false)
  uploadedByUserId          String?
  createdAt                 DateTime     @default(now())
  completedAt               DateTime?
  uploadedBy                User?        @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  rows                      ImportRow[]
  flights                   Flight[]

  @@index([fileHash, status])
  @@index([createdAt])
  @@index([flightDate])
  @@index([uploadedByUserId])
}

model ImportRow {
  id                   String          @id @default(cuid())
  importBatchId        String
  rowNumber            Int
  status               ImportRowStatus
  rawData              Json
  normalizedInstructor String?
  instructorId         String?
  warning              String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  importBatch          ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  instructor           Personnel?      @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([instructorId])
}

model Flight {
  id                      String       @id @default(cuid())
  externalId              String       @unique
  externalPlanId          String?
  signature               String       @unique
  status                  FlightStatus @default(COMPLETED)
  flightDate              DateTime
  landingDate             DateTime?
  sourceFlightCode        String?
  sourceTeam              String?
  trainingTask            String?
  sourceSortieNo          String?
  sourceFlightType        String?
  aircraftId              String?
  instructorId            String?
  studentId               String?
  secondStudentId         String?
  observerPersonnelId     String?
  studentName             String?
  departureAirport        String?
  arrivalAirport          String?
  offBlockTime            DateTime?
  onBlockTime             DateTime?
  takeoffTime             DateTime?
  landingTime             DateTime?
  airborneDurationMinutes Int?
  groundDurationMinutes   Int?
  sortieDurationMinutes   Int?
  flightRules             String?
  runway                  String?
  frequency               String?
  route                   String?
  remarks                 String?
  cancellationReason      String?
  endingTach              Decimal?     @db.Decimal(12, 2)
  landingCount            Int?
  hasFault                Boolean?
  faultDescription        String?
  faultState              String?
  upstreamUpdatedAt       DateTime?
  upstreamStatus          String?
  upstreamRealized        Int?
  upstreamCanceled        Int?
  upstreamIncomplete      Int?
  naeronPayload           Json?
  archived                Boolean      @default(false)
  importBatchId           String?
  archivedAt              DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  aircraft                Aircraft?    @relation(fields: [aircraftId], references: [id])
  instructor              Personnel?   @relation("FlightInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  observerPersonnel       Personnel?   @relation("FlightObserver", fields: [observerPersonnelId], references: [id], onDelete: SetNull)
  student                 Student?     @relation("PrimaryStudent", fields: [studentId], references: [id], onDelete: SetNull)
  secondStudent           Student?     @relation("SecondStudent", fields: [secondStudentId], references: [id], onDelete: SetNull)
  importBatch             ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([flightDate])
  @@index([status, flightDate])
  @@index([sourceTeam, flightDate])
  @@index([aircraftId])
  @@index([instructorId])
  @@index([studentId])
  @@index([secondStudentId])
  @@index([observerPersonnelId])
  @@index([importBatchId])
  @@index([takeoffTime])
  @@index([landingTime])
  @@index([archivedAt])
  @@index([upstreamUpdatedAt])
  @@index([archived])
}

model NaeronSyncState {
  id                   String    @id @default(cuid())
  tableName            String    @unique
  snapshotCursor       String?
  changesCursor        String?
  deletedCursor        String?
  lastSuccessfulSyncAt DateTime?
  lastFullSyncAt       DateTime?
  lastError            String?
  syncLockToken        String?
  syncLockedAt         DateTime?
  syncLockedByEmail    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([syncLockedAt])
}

model NaeronSyncBatch {
  id                   String         @id @default(cuid())
  tableName            String
  mode                 NaeronSyncMode
  startedAt            DateTime       @default(now())
  completedAt          DateTime?
  fetched              Int            @default(0)
  created              Int            @default(0)
  updated              Int            @default(0)
  archived             Int            @default(0)
  completedFlights     Int            @default(0)
  cancelledFlights     Int            @default(0)
  unmatchedInstructors Int            @default(0)
  unmatchedStudents    Int            @default(0)
  aircraftUpdated      Int            @default(0)
  errors               Int            @default(0)
  success              Boolean        @default(false)
  errorMessage         String?
  triggeredByEmail     String?

  @@index([tableName, startedAt])
  @@index([success, startedAt])
  @@index([triggeredByEmail, startedAt])
}

enum NaeronSyncMode {
  FULL
  INCREMENTAL
}

enum ImportStatus {
  PENDING
  PARSED
  REVIEW_REQUIRED
  IMPORTED
  FAILED
}

enum ImportRowStatus {
  READY
  REVIEW
  INVALID
  IMPORTED
  DUPLICATE
  CANCELLED
}

enum FlightStatus {
  COMPLETED
  CANCELLED
  INCOMPLETE
  UNKNOWN
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  importBatches ImportBatch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  DATA_MANAGER
  VIEWER
}
