generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Team {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Personnel {
  id                String       @id @default(cuid())
  sourceKey         String       @unique
  sourceSequence    Int?
  nationalId        String?      @unique
  firstName         String
  lastName          String
  phone             String?
  email             String?
  birthDate         DateTime?
  tshirtSize        String?
  licenseNo         String?
  notes             String?
  isActiveFlying    Boolean      @default(false)
  companyId         String?
  teamId            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  company           Company?     @relation(fields: [companyId], references: [id])
  team              Team?        @relation(fields: [teamId], references: [id])
  vehicles          Vehicle[]
  credentials       Credential[]
  instructedFlights Flight[]     @relation("FlightInstructor")
  importRows        ImportRow[]

  @@index([companyId])
  @@index([teamId])
  @@index([licenseNo])
  @@index([isActiveFlying])
}

model Vehicle {
  id          String    @id @default(cuid())
  personnelId String
  plate       String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, plate])
  @@index([personnelId, active])
}

model Credential {
  id          String         @id @default(cuid())
  personnelId String
  type        CredentialType
  expiryDate  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  personnel   Personnel      @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, type])
  @@index([type, expiryDate])
}

enum CredentialType {
  SEP
  SEP_FI
  CLASS_1
}

model AuthorizedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([role])
}

model Aircraft {
  id           String   @id @default(cuid())
  registration String   @unique
  aircraftType String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  flights      Flight[]

  @@index([active])
}

model Student {
  id             String   @id @default(cuid())
  normalizedName String   @unique
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  flights        Flight[]
}

model ImportBatch {
  id               String       @id @default(cuid())
  originalFilename String
  fileHash         String
  flightDate       DateTime?
  status           ImportStatus @default(PENDING)
  totalRows        Int          @default(0)
  validRows        Int          @default(0)
  importedRows     Int          @default(0)
  warningRows      Int          @default(0)
  rejectedRows     Int          @default(0)
  uploadedByUserId String?
  createdAt        DateTime     @default(now())
  completedAt      DateTime?
  uploadedBy       User?        @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  rows             ImportRow[]
  flights          Flight[]

  @@index([fileHash, status])
  @@index([createdAt])
  @@index([flightDate])
  @@index([uploadedByUserId])
}

model ImportRow {
  id                   String          @id @default(cuid())
  importBatchId        String
  rowNumber            Int
  status               ImportRowStatus
  rawData              Json
  normalizedInstructor String?
  instructorId         String?
  warning              String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  importBatch          ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  instructor           Personnel?      @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([instructorId])
}

model Flight {
  id                      String      @id @default(cuid())
  signature               String      @unique
  flightDate              DateTime
  sourceSortieNo          String?
  sourceFlightType        String?
  aircraftId              String
  instructorId            String?
  studentId               String?
  studentName             String?
  departureAirport        String?
  arrivalAirport          String?
  takeoffTime             DateTime?
  landingTime             DateTime?
  airborneDurationMinutes Int?
  groundDurationMinutes   Int?
  sortieDurationMinutes   Int?
  flightRules             String?
  runway                  String?
  frequency               String?
  remarks                 String?
  importBatchId           String
  archivedAt              DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  aircraft                Aircraft    @relation(fields: [aircraftId], references: [id])
  instructor              Personnel?  @relation("FlightInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  student                 Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  importBatch             ImportBatch @relation(fields: [importBatchId], references: [id])

  @@index([flightDate])
  @@index([aircraftId])
  @@index([instructorId])
  @@index([studentId])
  @@index([importBatchId])
  @@index([takeoffTime])
  @@index([landingTime])
  @@index([archivedAt])
}

enum ImportStatus {
  PENDING
  PARSED
  REVIEW_REQUIRED
  IMPORTED
  FAILED
}

enum ImportRowStatus {
  READY
  REVIEW
  INVALID
  IMPORTED
  DUPLICATE
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  importBatches ImportBatch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  DATA_MANAGER
  VIEWER
}
