generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Team {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  personnel Personnel[]
}

model Personnel {
  id             String       @id @default(cuid())
  sourceKey      String       @unique
  sourceSequence Int?
  nationalId     String?      @unique
  firstName      String
  lastName       String
  phone          String?
  email          String?
  birthDate      DateTime?
  tshirtSize     String?
  licenseNo      String?
  notes          String?
  isActiveFlying Boolean      @default(false)
  companyId      String?
  teamId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company?     @relation(fields: [companyId], references: [id])
  team           Team?        @relation(fields: [teamId], references: [id])
  vehicles       Vehicle[]
  credentials    Credential[]

  @@index([companyId])
  @@index([teamId])
  @@index([licenseNo])
  @@index([isActiveFlying])
}

model Vehicle {
  id          String    @id @default(cuid())
  personnelId String
  plate       String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, plate])
  @@index([personnelId, active])
}

model Credential {
  id          String         @id @default(cuid())
  personnelId String
  type        CredentialType
  expiryDate  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  personnel   Personnel      @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, type])
  @@index([type, expiryDate])
}

enum CredentialType {
  SEP
  SEP_FI
  CLASS_1
}
